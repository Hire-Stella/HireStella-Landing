# Lead delivery. Configure at least one channel before launch, or every form
# returns "delivery is not configured". See src/lib/lead-delivery.ts.
#
# Resend email: the team receives each lead and the visitor gets a thank-you.
# Use a sending-access key; the FROM address must be on a domain verified in
# Resend. LEAD_EMAIL_TO may hold several addresses, comma-separated.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
# Optional HTTPS webhook (Zapier, Make, n8n, CRM). Works alongside Resend.
LEAD_WEBHOOK_URL=
# Optional bearer token sent only from the server to the webhook.
LEAD_WEBHOOK_TOKEN=
# Public canonical origin, without a trailing slash. Set for the production site.
NEXT_PUBLIC_SITE_URL=
# Dograh embed token for the live voice Stella. Public by design; scoped per
# environment, so staging and production should not share one. Required: with
# no token the launcher hides the voice option.
NEXT_PUBLIC_DOGRAH_TOKEN=
# Dograh embed token for the live chat Stella — a separate token, provisioned
# on Dograh's dashboard with widgetType "chat" rather than "voice". Required:
# with no token the launcher hides the chat option. The two tokens' scripts
# share one global (window.DograhWidget), so only one can be live at a time;
# the loaders in voice-agent.tsx / chat-agent.tsx force a clean reload when
# the visitor switches between them.
NEXT_PUBLIC_DOGRAH_CHAT_TOKEN=
# Voice platform origin, shared by both tokens above. Only set to override
# the default.
NEXT_PUBLIC_DOGRAH_ENDPOINT=
# Google Tag Manager container, e.g. GTM-XXXXXXX. Leave blank outside
# production so preview and local builds never reach the live container.
# GA4 and the Google Ads conversion are configured inside the container; the
# /thank-you conversion is pushed as `generate_lead`.
NEXT_PUBLIC_GTM_ID=
# Meta Pixel ID. Blank disables the pixel entirely. The Pixel `Lead` event
# fires from /thank-you only, after a request was actually delivered.
NEXT_PUBLIC_META_PIXEL_ID=
