# Optional HTTPS webhook for consultation requests. Configure before launch.
LEAD_WEBHOOK_URL=
# Optional bearer token sent only from the server to the webhook.
LEAD_WEBHOOK_TOKEN=
# Public canonical origin, without a trailing slash. Set for the production site.
NEXT_PUBLIC_SITE_URL=
# Dograh embed token for the live voice Stella. Public by design; scoped per
# environment, so staging and production should not share one. Required: with
# no token the launcher hides the voice option and offers chat only.
NEXT_PUBLIC_DOGRAH_TOKEN=
# Voice platform origin. Only set to override the default.
NEXT_PUBLIC_DOGRAH_ENDPOINT=
# Google Tag Manager container, e.g. GTM-XXXXXXX. Leave blank outside
# production so preview and local builds never reach the live container.
NEXT_PUBLIC_GTM_ID=
# Meta Pixel ID. Blank disables the pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=
